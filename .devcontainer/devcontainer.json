// Dev Containers definition for arraw (ADR 0044). Shares one image with the
// CLI launcher (tools/sandbox.py) so they can't drift. Works across editors
// that speak the Dev Containers spec: VS Code, JetBrains/PyCharm, Zed.
//
// Note: this opens an interactive dev environment (build/test/edit). It does
// NOT auto-launch the agent with permissions skipped — that autonomous mode is
// the CLI's job (`just sandbox`). Here you run `claude` yourself in the
// integrated terminal.
{
  "name": "arraw-dev",
  "build": {
    "dockerfile": "Containerfile",
    "context": "."
  },

  // Mount the repo at the SAME absolute path it has on the host, so CMake's
  // cached absolute paths stay valid whether the last build ran here or on the
  // host (ADR 0044). build/ is shared with the host on purpose.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // keep-id: run as the host UID so files stay host-owned and editable.
  // label=disable: access the bind mount under enforcing SELinux without
  // recursively relabelling host directories (ADR 0044).
  "runArgs": ["--userns=keep-id", "--security-opt=label=disable"],

  "containerEnv": {
    "HOME": "/home/dev"
  }
}
