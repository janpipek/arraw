<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.janpipek.arraw</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>arraw</name>
  <summary>Lightweight RAW photo editor with a real-time GPU preview</summary>
  <developer id="io.github.janpipek">
    <name>Jan Pipek</name>
  </developer>
  <description>
    <p>
      arraw is a lightweight, cross-platform RAW photo editor with a
      Lightroom-style development workflow: open a folder, edit
      non-destructively with a real-time GPU preview, and export. It is an
      editor for developing and culling photos, not a catalogue or
      digital-asset manager.
    </p>
    <p>Features:</p>
    <ul>
      <li>Non-destructive editing with Lightroom-compatible XMP sidecars</li>
      <li>Real-time GPU preview of every adjustment</li>
      <li>Tone curves, local adjustments, crop and straighten</li>
      <li>Culling with ratings and colour labels</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.janpipek.arraw.desktop</launchable>
  <provides>
    <mediatype>image/x-canon-cr2</mediatype>
    <mediatype>image/x-canon-cr3</mediatype>
    <mediatype>image/x-nikon-nef</mediatype>
    <mediatype>image/x-sony-arw</mediatype>
    <mediatype>image/x-adobe-dng</mediatype>
    <mediatype>image/x-fuji-raf</mediatype>
    <mediatype>image/x-olympus-orf</mediatype>
    <mediatype>image/x-panasonic-rw2</mediatype>
    <mediatype>image/x-pentax-pef</mediatype>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/tiff</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/bmp</mediatype>
  </provides>
