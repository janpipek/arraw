# Build environment for the arraw Linux AppImage.
# Mirrors the CI host in .github/workflows/release.yml: ubuntu:24.04 (glibc 2.39)
# with Qt 6.8 from aqtinstall, giving the AppImage the same glibc floor as the
# artifact attached to a GitHub Release.
#
# Build once (cached); re-run the container for each code change via `just appimage`
# or manually:
#
#   podman build -t arraw-appimage-builder \
#       -f packaging/linux/Containerfile packaging/linux
#   podman run --rm \
#       -v $PWD:/src:ro,z -v $PWD/dist:/dist:z \
#       arraw-appimage-builder bash /src/packaging/linux/build-appimage.sh

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# System build dependencies — the list is shared with release.yml via
# apt-build-deps.txt so the two AppImage build paths can't drift. python3-pip is
# added here only for this image's in-container aqt Qt provisioning (CI uses
# install-qt-action instead). The build context is packaging/linux/ (see header).
COPY apt-build-deps.txt /tmp/apt-build-deps.txt
RUN apt-get update -q && \
    grep -vE '^[[:space:]]*(#|$)' /tmp/apt-build-deps.txt \
        | xargs apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-build-deps.txt

# Qt 6.8.3 via aqtinstall — same version pinned by CI.
# Baked into the image so `podman build` caches it; only re-runs when the
# Containerfile changes, not on every code change.
RUN pip3 install -q --break-system-packages aqtinstall && \
    python3 -m aqt install-qt linux desktop 6.8.3 linux_gcc_64 \
        -m qtshadertools --outputdir /opt/qt && \
    pip3 uninstall -y --break-system-packages aqtinstall && \
    rm -rf /root/.cache

ENV QT=/opt/qt/6.8.3/gcc_64
ENV PATH="$QT/bin:$PATH"
ENV LD_LIBRARY_PATH="$QT/lib"
