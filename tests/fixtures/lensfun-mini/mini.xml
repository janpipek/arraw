<lensdatabase version="1">
    <!-- Fixed, self-contained lensfun database for deterministic tests. One mount,
         one camera, one lens with known distortion / TCA / vignetting calibration.
         Independent of the system lensfun database (docs/lens-corrections-plan.md). -->
    <mount>
        <name>arrawtest</name>
    </mount>

    <camera>
        <maker>ArrawTest</maker>
        <model>TestCam</model>
        <mount>arrawtest</mount>
        <cropfactor>1.5</cropfactor>
    </camera>

    <lens>
        <maker>ArrawTest</maker>
        <model>TestLens 50mm F2.8</model>
        <mount>arrawtest</mount>
        <cropfactor>1.5</cropfactor>
        <calibration>
            <!-- Noticeable barrel distortion so the resolved scale departs from 1. -->
            <distortion model="ptlens" focal="50" a="0.0" b="-0.02" c="0.0"/>
            <!-- Red and blue scale apart from green for a measurable TCA split. -->
            <tca model="poly3" focal="50" vr="1.0010" vb="0.9990"/>
            <!-- Strong corner falloff (negative k1) so correction brightens corners. -->
            <vignetting model="pa" focal="50" aperture="2.8" distance="1000" k1="-0.8" k2="0.2" k3="-0.1"/>
        </calibration>
    </lens>
</lensdatabase>
